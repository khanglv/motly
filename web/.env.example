# Domain chính thức của website (dùng cho canonical, hreflang, sitemap, Open Graph).
# Trên Vercel có thể bỏ trống: sẽ tự dùng VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://motly.vn

# URL của API NestJS (chỉ dùng phía server, không lộ ra trình duyệt).
# Để trống thì web dùng dữ liệu mẫu trong src/data và trang /admin không hoạt động.
# Dev: http://localhost:4000 · Production: https://motly-api.onrender.com
API_URL=http://localhost:4000

# Secret dùng chung với REVALIDATE_SECRET bên api, để CMS lưu xong thì web cập nhật ngay
REVALIDATE_SECRET=
