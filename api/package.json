{
  "name": "motly-api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS cho website Một Ly Cafe's và Matcha (nội dung + CMS)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f ../docker-compose.yml up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^12",
    "@nestjs/config": "^12",
    "@nestjs/core": "^12",
    "@nestjs/jwt": "^12",
    "@nestjs/mapped-types": "^12.0.1",
    "@nestjs/platform-express": "^12",
    "@nestjs/throttler": "^6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12",
    "@nestjs/schematics": "^12",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "type": "module"
}
