# ---------- Database ----------
# Dev (Docker): postgresql://motly:motly@localhost:5433/motly
# Neon: DATABASE_URL = chuỗi có "-pooler" trong host; DIRECT_URL = cùng chuỗi nhưng bỏ "-pooler"
# Nên dùng sslmode=verify-full
DATABASE_URL="postgresql://motly:motly@localhost:5433/motly"
DIRECT_URL="postgresql://motly:motly@localhost:5433/motly"

# ---------- Server ----------
PORT=4000
NODE_ENV=development

# ---------- Đăng nhập CMS ----------
# Chuỗi ngẫu nhiên dài (ví dụ: openssl rand -base64 48)
JWT_SECRET="change-me-to-a-long-random-string"
# Tài khoản admin duy nhất, được tạo/cập nhật khi chạy `pnpm db:seed`
ADMIN_EMAIL="admin@motly.vn"
ADMIN_PASSWORD="change-me-please"
# true khi chạy HTTPS (production)
COOKIE_SECURE=false

# ---------- Làm mới cache của web ----------
# URL của web Next.js và secret dùng chung với REVALIDATE_SECRET bên web
WEB_URL="http://localhost:3000"
REVALIDATE_SECRET="change-me-shared-secret"

# ---------- Neon Object Storage (upload ảnh) ----------
# Neon Console → project → Object storage → New bucket (Access: public_read), rồi tạo credential
# có quyền storage:read + storage:write. Để trống thì CMS chỉ cho dán link ảnh.
AWS_ENDPOINT_URL_S3=""
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="motly-images"
